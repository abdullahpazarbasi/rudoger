@host = http://localhost:8080
@token = replace-after-login
@productId = 00000000-0000-0000-0000-000000000000
@stockItemId = 00000000-0000-0000-0000-000000000000
@orderId = 00000000-0000-0000-0000-000000000000

### Exchange credentials
POST {{host}}/api/v1/authn/tokens
Content-Type: application/json
X-Correlation-Id: example-login

{
  "username": "abdullah",
  "password": "12345678"
}

### Create a product and its level-zero packaging
POST {{host}}/api/v1/product/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sku": "COFFEE-001",
  "name": "Coffee",
  "baseUomCode": "EA",
  "basePriceAmount": 2.50,
  "basePriceCurrencyCode": "TRY",
  "packagings": [
    {
      "level": 0,
      "uomCode": "EA",
      "conversionFactor": 1,
      "barcode": "869000000001"
    },
    {
      "level": 1,
      "uomCode": "CASE",
      "conversionFactor": 10,
      "barcode": "869000000010"
    }
  ]
}

### Open stock
POST {{host}}/api/v1/inventory/stock-items
Authorization: Bearer {{token}}
Idempotency-Key: stock-open-coffee-001
Content-Type: application/json

{
  "productId": "{{productId}}",
  "openingQuantity": 100
}

### Place an order; poll the Location response header
POST {{host}}/api/v1/order/orders
Authorization: Bearer {{token}}
Idempotency-Key: order-coffee-001
Content-Type: application/json

{
  "lines": [
    {
      "productId": "{{productId}}",
      "uomCode": "CASE",
      "quantity": 2
    }
  ]
}

### Ship an order; poll the Location response header
POST {{host}}/api/v1/order/orders/{{orderId}}/transitions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "target": "Shipped"
}
